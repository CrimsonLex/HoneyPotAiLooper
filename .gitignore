# --- Entornos virtuales ---
.venv/
venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Datos generados (NO subir: contienen interacciones) ---
data/sessions/*.json
data/captures/
data/metrics/
logs/*.log

# --- Excepciones: conservar estructura de carpetas vacías ---
!data/sessions/.gitkeep
!data/captures/.gitkeep
!data/metrics/.gitkeep
!logs/.gitkeep

# --- Modelos (se descargan con ollama pull) ---
models/*.gguf
models/*.bin

# --- Secretos ---
.env
config/.env
config/settings.local.yaml

# --- IDE / SO ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini